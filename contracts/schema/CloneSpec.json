{
  "$defs": {
    "RetryPolicy": {
      "additionalProperties": false,
      "description": "Orders' call policy towards Payments \u2014 observable production config.",
      "properties": {
        "max_retries": {
          "default": 3,
          "maximum": 5,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "timeout_ms": {
          "default": 500,
          "maximum": 10000,
          "minimum": 50,
          "title": "Timeout Ms",
          "type": "integer"
        }
      },
      "title": "RetryPolicy",
      "type": "object"
    },
    "WorkloadSpec": {
      "additionalProperties": false,
      "description": "Open-loop request rate to replay into a clone (reconstructed from observed production load).",
      "properties": {
        "rps": {
          "default": 80.0,
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "title": "Rps",
          "type": "number"
        }
      },
      "title": "WorkloadSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What a clone inherits: only what Faultline may legitimately know about production.",
  "properties": {
    "name": {
      "pattern": "^[a-z0-9_-]{1,32}$",
      "title": "Name",
      "type": "string"
    },
    "patch_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Patch Ref"
    },
    "retry_policy": {
      "$ref": "#/$defs/RetryPolicy"
    },
    "versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Versions",
      "type": "object"
    },
    "workload": {
      "$ref": "#/$defs/WorkloadSpec"
    }
  },
  "required": [
    "name"
  ],
  "title": "CloneSpec",
  "type": "object"
}
