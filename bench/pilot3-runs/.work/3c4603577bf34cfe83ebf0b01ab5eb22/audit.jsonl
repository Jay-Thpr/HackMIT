io 0.98 indicates nearly saturated DB connection pool","db.query_p99_ms 1.49s, indicates prolonged slowness not only spike","payments.db error rate ~90%, matching user-facing failures"]}],"predictions":[{"hypothesis_id":"H_meta","experiment_id":"retry_cap_0_20s","during":[{"metric":"svc.gateway.p99_ms","direction":"down"},{"metric":"svc.gateway.error_rate","direction":"down"},{"metric":"svc.orders.retry_ratio","direction":"down"},{"metric":"db.pool_busy_ratio","direction":"down"}],"after_release":[{"metric":"svc.gateway.p99_ms","direction":"flat"},{"metric":"svc.gateway.error_rate","direction":"flat"},{"metric":"svc.orders.retry_ratio","direction":"flat"},{"metric":"db.pool_busy_ratio","direction":"flat"}],"confirms_if":{"phase":"after_release","metric":"svc.gateway.p99_ms","expect":"within_baseline"}},{"hypothesis_id":"H_db","experiment_id":"retry_cap_0_20s","during":[{"metric":"svc.gateway.p99_ms","direction":"down"},{"metric":"svc.gateway.error_rate","direction":"down"},{"metric":"svc.orders.retry_ratio","direction":"down"},{"metric":"db.pool_busy_ratio","direction":"down"}],"after_release":[{"metric":"svc.gateway.p99_ms","direction":"up"},{"metric":"svc.gateway.error_rate","direction":"up"},{"metric":"svc.orders.retry_ratio","direction":"up"},{"metric":"db.pool_busy_ratio","direction":"up"}],"confirms_if":{"phase":"after_release","metric":"svc.gateway.p99_ms","expect":"up"}},{"hypothesis_id":"H_meta","experiment_id":"shed_10_20s","during":[{"metric":"svc.gateway.p99_ms","direction":"down"},{"metric":"svc.gateway.error_rate","direction":"down"},{"metric":"db.pool_busy_ratio","direction":"down"}],"after_release":[{"metric":"svc.gateway.p99_ms","direction":"flat"},{"metric":"svc.gateway.error_rate","direction":"flat"},{"metric":"db.pool_busy_ratio","direction":"flat"}],"confirms_if":null},{"hypothesis_id":"H_db","experiment_id":"shed_10_20s","during":[{"metric":"svc.gateway.p99_ms","direction":"down"},{"metric":"svc.gateway.error_rate","direction":"down"},{"metric"