l services show high latency"]},{"id":"H_cpu","label":"resource exhaustion (pool/CPU/threads)","description":"Orders and/or payments might be hitting their resource/pool/CPU limit, contributing to high latency and errors regardless of backend.","evidence":["All services exhibit high error and latency rates","No strong evidence against local resource or thread pool saturation"]}],"predictions":[{"hypothesis_id":"H_meta","experiment_id":"retry_cap_0_20s","during":[{"metric":"svc.gateway.p99_ms","direction":"down"},{"metric":"svc.orders.retry_ratio","direction":"down"},{"metric":"db.pool_busy_ratio","direction":"down"}],"after_release":[{"metric":"svc.gateway.p99_ms","direction":"flat"},{"metric":"svc.orders.retry_ratio","direction":"flat"},{"metric":"db.pool_busy_ratio","direction":"flat"}],"confirms_if":{"phase":"after_release","metric":"svc.gateway.p99_ms","expect":"within_baseline"}},{"hypothesis_id":"H_db","experiment_id":"retry_cap_0_20s","during":[{"metric":"svc.gateway.p99_ms","direction":"down"},{"metric":"db.pool_busy_ratio","direction":"down"}],"after_release":[{"metric":"svc.gateway.p99_ms","direction":"up"},{"metric":"db.pool_busy_ratio","direction":"up"}],"confirms_if":{"phase":"during","metric":"svc.gateway.p99_ms","expect":"within_baseline"}},{"hypothesis_id":"H_cpu","experiment_id":"retry_cap_0_20s","during":[{"metric":"svc.gateway.p99_ms","direction":"down"}],"after_release":[{"metric":"svc.gateway.p99_ms","direction":"up"}],"confirms_if":{"phase":"during","metric":"svc.gateway.p99_ms","expect":"within_baseline"}},{"hypothesis_id":"H_meta","experiment_id":"shed_10_20s","during":[{"metric":"svc.gateway.p99_ms","direction":"down"}],"after_release":[{"metric":"svc.gateway.p99_ms","direction":"flat"}],"confirms_if":null},{"hypothesis_id":"H_db","experiment_id":"shed_10_20s","during":[{"metric":"svc.gateway.p99_ms","direction":"down"},{"metric":"db.pool_busy_ratio","direction":"down"}],"after_release":[{"metric":"svc.gateway.p99_ms","direction":"up"},{"met