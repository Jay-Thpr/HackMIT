# Elastic Cloud deployment (Kibana → Deployment → Elasticsearch endpoint) — leave unset to skip ES persistence
FAULTLINE_ELASTICSEARCH_URL=https://<deployment>.es.<region>.<provider>.elastic-cloud.com:443
# The sandbox OTel collector also exports OTLP to <url>/_otlp (needs Elasticsearch 9.x native OTLP intake);
# unset → collector stays on its local debug sink.
# Kibana → Stack Management → API keys → Create; needs write on faultline-* and read on _query
FAULTLINE_ELASTICSEARCH_API_KEY=
# Optional second Elastic project (Observability, holds the OTel data). When set, faultline-fingerprints and
# faultline-audit are also written there so APM and the C1/C4 evidence sit in one Kibana. Reads stay on the primary.
FAULTLINE_ELASTICSEARCH_MIRROR_URL=
FAULTLINE_ELASTICSEARCH_MIRROR_API_KEY=
KIBANA_MIRROR_URL=
# Local fallback: FAULTLINE_ELASTICSEARCH_URL=http://localhost:9200 with no key
OPENAI_API_KEY=
DEVIN_API_KEY=
FAULTLINE_OTLP_ENDPOINT=
FAULTLINE_OTLP_API_KEY=
FAULTLINE_OBSERVABILITY_ELASTICSEARCH_URL=
FAULTLINE_OBSERVABILITY_ELASTICSEARCH_API_KEY=
FAULTLINE_OBSERVABILITY_KIBANA_URL=
FAULTLINE_OBSERVABILITY_ELASTICSEARCH_SETUP_API_KEY=
FAULTLINE_ELASTICSEARCH_SETUP_API_KEY=
FAULTLINE_MIRROR_OUTBOX_DIR=
FAULTLINE_ELASTICSEARCH_MIRROR_URL=
FAULTLINE_ELASTICSEARCH_MIRROR_API_KEY=
